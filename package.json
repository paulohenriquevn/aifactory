{
  "name": "aifactory",
  "version": "0.2.0",
  "private": true,
  "description": "A software factory that turns GitHub issues into verified pull requests with coding agents running in cloud sandboxes.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "theokit dev",
    "build": "theokit build",
    "start": "theokit start",
    "preview": "theokit preview",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "coverage": "vitest run --project unit --project integration --no-file-parallelism --coverage",
    "crap": "node scripts/crap.mjs",
    "dup": "jscpd",
    "mutation": "stryker run",
    "quality": "pnpm coverage && pnpm crap && pnpm dup && pnpm mutation",
    "test:e2e": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --project e2e --no-file-parallelism",
    "evals": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --project evals",
    "evals:cases": "EVALS_MODE=cases node --env-file=.env.local node_modules/vitest/vitest.mjs run --project evals",
    "evals:check": "EVALS_MODE=check node --env-file=.env.local node_modules/vitest/vitest.mjs run --project evals",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "theokit db generate",
    "db:migrate": "theokit db migrate"
  },
  "dependencies": {
    "@theokit/agents": "^16.3.0",
    "@theokit/sdk": "^5.14.0",
    "@theokit/ui": "^1.12.2",
    "@usetheo/ui": "^0.35.4",
    "@vercel/sandbox": "^3.9.1",
    "drizzle-orm": "0.45.4",
    "e2b": "2.63.0",
    "lucide-react": "0.471.2",
    "pg": "8.23.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "theokit": "^0.79.0",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jscpd": "^5.4.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
