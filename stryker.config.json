{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/server/factory/evidence.ts",
    "src/server/factory/release.ts",
    "src/server/factory/review.ts:60-140",
    "src/server/factory/guards.ts",
    "src/server/factory/watch.ts:1-40",
    "src/server/factory/waiting.ts:1-90",
    "src/shared/panel.ts",
    "src/app/lib/format.ts",
    "src/server/factory/plan.ts:1-76",
    "src/server/factory/repo-config.ts:20-23","src/server/factory/repo-config.ts:40-60",
    "src/server/panel/work.ts:44-80"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral", "TemplateLiteral"]
  },
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "timeoutMS": 20000,
  "concurrency": 4,
  "plugins": ["@stryker-mutator/vitest-runner"]
}
