[Unit]
Description=aifactory server (issues to verified pull requests)
After=network-online.target

[Service]
WorkingDirectory=@ROOT@
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=@ROOT@/scripts/run-server.sh
Restart=always
RestartSec=5
# A stop signals only theokit, which stops taking jobs and waits for the run in progress (up to 92 minutes,
# see src/server/factory/drain.ts); the agent's commands keep running meanwhile. Past this, systemd kills all.
KillMode=mixed
TimeoutStopSec=93min

[Install]
WantedBy=default.target
