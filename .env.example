# Postgres for the factory's state. `docker compose up -d` serves this one locally.
DATABASE_URL=postgres://factory:factory@localhost:54329/factory

# Secret configured on the GitHub webhook (Settings > Webhooks). Without it /api/webhooks/github answers 503.
GITHUB_WEBHOOK_SECRET=

# The factory's GitHub App. `node scripts/github-app-setup.mjs` registers it and fills these in
# (.env.local), with the private key in .secrets/. GITHUB_WEBHOOK_SECRET above is the app's.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=

# How Claude Code pays. Held by the factory and attached by the sandbox firewall; the agent never
# sees it. Set one: a Console API key, or the one-year subscription token from `claude setup-token`.
# With both set the subscription is used; FACTORY_CLAUDE_AUTH=api-key|subscription overrides.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
FACTORY_CLAUDE_AUTH=

# Which agent runs a task when the issue has no `harness:<name>` label: claude-code (default) or codex.
FACTORY_HARNESS=

# How Codex pays. An API key, or the factory's own ChatGPT login: run
# `CODEX_HOME=~/.codex-factory-1 codex login --device-auth` (not your everyday ~/.codex, because the
# refresh token rotates and two users of one login invalidate each other).
# FACTORY_CODEX_AUTH=api-key|subscription picks when both exist; FACTORY_CODEX_HOME moves the login.
OPENAI_API_KEY=
FACTORY_CODEX_AUTH=
FACTORY_CODEX_HOME=

# Vercel Sandbox, with a token that does not expire in 12 hours (team and project in .vercel/project.json).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Vercel Sandbox: `vercel link` then `vercel env pull .env.local` writes VERCEL_OIDC_TOKEN (12 h).
VERCEL_OIDC_TOKEN=

# The panel (http://localhost:3000). One owner, who signs in with FACTORY_PANEL_TOKEN; the session
# cookie is encrypted with FACTORY_PANEL_SECRET. Both must be at least 32 characters, for example
# `openssl rand -base64 36`. Without them the panel refuses everyone.
FACTORY_PANEL_TOKEN=
FACTORY_PANEL_SECRET=

# What the factory does with a release (merging a delivered pull request and publishing a version).
# It always makes a pre-release. manual (default): only a person releases, from the panel.
# trial: records what an agent would have released. auto: releases a commit with green checks and an
# approving review.
FACTORY_RELEASE_MODE=

# The writing assistant under every text box in the panel. It calls the model provider directly with this
# key (a subscription token cannot be used for it). FACTORY_ASSIST_MODEL changes the model, with the key of
# its provider (anthropic/ needs ANTHROPIC_API_KEY, openrouter/ needs OPENROUTER_API_KEY).
# FACTORY_ASSIST_MODEL=anthropic/claude-sonnet-4-6

# The assistant in the panel's chat. OpenRouter needs OPENROUTER_API_KEY; the ChatGPT option uses the
# subscription connected from the chat itself (stored in ~/.theokit/auth.json), so it needs no key here.
# OPENROUTER_API_KEY=
# FACTORY_CHAT_MODEL=openrouter/google/gemini-2.5-flash
# FACTORY_CHAT_CODEX_MODEL=openai-chatgpt/gpt-5.4

# Where sandboxes run: vercel (default) or docker, containers on this machine behind a proxy that enforces
# the domain allowlist and attaches credentials outside the container. FACTORY_SANDBOX_MEMORY (5g) and
# FACTORY_SANDBOX_CPUS (3) size each one.
# FACTORY_SANDBOX=docker
